# 统一行尾：文本文件一律 LF（仓库内），避免跨平台 CRLF/LF 噪音
* text=auto

*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.user.js text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制保持原样
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
